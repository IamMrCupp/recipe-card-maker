# Python cruft
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# App data — the SQLite store is a working DB, not source of truth (exported to
# markdown by §3.A.3). Never commit it.
_app/var/
*.db
*.sqlite3

# Local image blob store (§3.E.1). Originals live here, full quality; export
# materializes downsized web copies into a committed images/ dir instead.
_media/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# If you'd rather treat PDFs as untracked build artifacts, uncomment:
# *_full.pdf
# *_4x6.pdf
